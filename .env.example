# LifeLedger NG - Environment Configuration Template
# NOTE: Never commit sensitive keys or populated .env files to source control.

# Supabase Client (Exposed to browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side Secrets (Used in Vercel Functions only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# Email & Notifications (Resend / Brevo / SMTP)
EMAIL_PROVIDER_API_KEY=your-email-provider-key

# Payment Processing (Phase 4 - Paystack)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# Scheduled Tasks (Vercel Cron)
CRON_SECRET=your-random-cron-secret-token
